<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/studentList"
        android:name="com.bpitindia.attendance.StudentListFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        app:layoutManager="LinearLayoutManager"
        tools:context=".StudentListFragment"
        tools:listitem="@layout/student_list_item" />

    <TextView
        android:id="@+id/no_student"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="32sp"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:visibility="gone"
        android:text="@string/student_data_not_available" />

    <ProgressBar
        android:id="@+id/student_progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/loaderColor"
        android:visibility="gone" />
</FrameLayout>